# Copy to .env (or run ./scripts/init-env.sh, which generates strong secrets).
# Values below are placeholders only. Never commit a real .env.
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

# S3 credentials for the SeaweedFS object store
S3_ACCESS_KEY=change-me-key
S3_SECRET_KEY=change-me-secret

# Host port Caddy listens on (single origin for UI and API)
HTTP_PORT=8080

# Identity
JWT_SECRET=change-me-generate-at-least-32-random-chars
# true in any environment served over HTTPS (required when APP_ENV=prod)
COOKIE_SECURE=false

# "dev" starts Mailpit (captures outgoing email at http://localhost:8025). Use real SMTP in prod.
COMPOSE_PROFILES=dev
