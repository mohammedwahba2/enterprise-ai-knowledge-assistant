{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		# flush_interval -1: stream responses immediately (chat answers use SSE in later stages)
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
